[Desktop Entry]
Type=Application
Name=Stream Goat
GenericName=Media Center
Comment=Movies, series, anime and Live TV from CloudStream extensions
Exec=@EXEC@ %u
Icon=@ICON@
Terminal=false
Categories=AudioVideo;Video;Player;
MimeType=x-scheme-handler/cloudstreamrepo;
# JavaFX names the window after the Application class; this maps it to our icon.
StartupWMClass=com.lagradost.cloudstream3.linux.ui.DesktopApp
